FROM node:20-alpine
WORKDIR /app
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ARG NEXT_PUBLIC_PLATFORM_VERSION=1.0.0
ARG NEXT_PUBLIC_ENVIRONMENT=dev
ARG NEXT_PUBLIC_AUTH_URL=https://auth.sendcraft.net
ARG NEXT_PUBLIC_AUTH_APP_ID=
ARG NEXT_PUBLIC_AUTH_PUBLIC_API_KEY=
ARG NEXT_PUBLIC_AUTH_REDIRECT_URI=http://localhost:3000/callback
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_PLATFORM_VERSION=$NEXT_PUBLIC_PLATFORM_VERSION
ENV NEXT_PUBLIC_ENVIRONMENT=$NEXT_PUBLIC_ENVIRONMENT
ENV NEXT_PUBLIC_AUTH_URL=$NEXT_PUBLIC_AUTH_URL
ENV NEXT_PUBLIC_AUTH_APP_ID=$NEXT_PUBLIC_AUTH_APP_ID
ENV NEXT_PUBLIC_AUTH_PUBLIC_API_KEY=$NEXT_PUBLIC_AUTH_PUBLIC_API_KEY
ENV NEXT_PUBLIC_AUTH_REDIRECT_URI=$NEXT_PUBLIC_AUTH_REDIRECT_URI
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
RUN npm run build
EXPOSE 3000
CMD ["npm","start"]
