# Default local persistence for Docker Compose.
DATA_STORE=file
DATA_FILE=/data/function-platform.json

# Recommended for DATA_STORE=file: encrypts the whole JSON data file at rest.
# Generate a stable key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# DATA_ENCRYPTION_KEY=replace-with-a-stable-secret
# DATA_ENCRYPTION_REQUIRED=true

# Local frontend -> backend URL. In Azure, replace it with the backend Container App URL.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ENVIRONMENT=dev
# Optional tenant used to backfill local sample data in file store.
DEFAULT_TENANT_ID=

# External auth provider used by the landing page and callback flow.
# The app reads AUTH_*, NEXT_PUBLIC_* and VITE_* aliases for the public values.
AUTH_URL=https://auth.sendcraft.net
AUTH_APP_ID=app_xxxxxxxxxxxx
AUTH_PUBLIC_API_KEY=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_REDIRECT_URI=http://localhost:3000/callback

# In Azure this value is generated automatically from the deployed Web Container App URL.
# Local dev can keep the explicit localhost value above.

# Auth config is shared across environments for now. Keep the same AUTH_ values
# in every deployment target; the platform injects the redirect URI dynamically.
# AUTH_REDIRECT_URI_DEV=http://localhost:3000/callback
# AUTH_REDIRECT_URI_TEST=https://your-test-web.example.com/callback
# AUTH_REDIRECT_URI_PROD=https://your-prod-web.example.com/callback

# Token exchange endpoint used after the callback code returns.
# The server calls this URL directly and sends AUTH_API_KEY as X-Integration-Key.
AUTH_VALIDATE_TOKEN=https://api.example.com/functions/v1/auth-exchange-code
AUTH_API_KEY=pub_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional legacy aliases if you prefer the Vite naming in your environment.
# VITE_AUTH_URL=https://auth.sendcraft.net
# VITE_AUTH_APP_ID=app_xxxxxxxxxxxx
# VITE_AUTH_API_KEY=ak_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_REDIRECT_URI=http://localhost:3000/callback

# Optional: use PostgreSQL instead of file storage.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require

# Optional: enables AI review before deployment.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional: CORS defaults propagated to deployed function containers.
# FPM_CORS_ORIGINS=*
# FPM_CORS_HEADERS=authorization,content-type,x-api-key
# FPM_CORS_ALLOW_CREDENTIALS=false
